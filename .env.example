# Alize environment
# The app is BYOK + local-first; almost all config happens IN-APP (Settings page).
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Canonical URL (used for metadata / PWA). Optional in dev.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: AI provider keys, GitHub tokens, and model choices are entered by the user
# in-app and stored in their browser (localStorage). They are NOT env vars.
